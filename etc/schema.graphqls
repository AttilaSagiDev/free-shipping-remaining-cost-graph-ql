type Query {
    guestCartRemainingCost(cart_id: String! @doc(description: "The unique ID of the cart to query.")): RemainingCost @resolver (class: "\\Space\\FreeShippingRemainingCostGraphQl\\Model\\Resolver\\GuestCartRemainingCost") @doc(description:"Return information about the remaining cost of the specified shopping cart.") @cache(cacheable: false)
    customerCartRemainingCost: Space_FreeShippingRemainingCostGraphQlCost! @resolver (class: "\\Space\\FreeShippingRemainingCostGraphQl\\Model\\Resolver\\CustomerCartRemainingCost") @doc(description:"Return information about the customer's remaining cost of the shopping cart.") @cache(cacheable: false)
}

type RemainingCost @doc(description: "Defines details about the remaining cost of the cart.") {
    message: String! @doc(description: "Required. The message of the remaining cost.")
    value: String! @doc(description: "Required. The value of the remaining cost.")
}
